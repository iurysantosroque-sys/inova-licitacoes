# Somente no ambiente da Edge Function. NUNCA carregar este arquivo no frontend.
GEMINI_API_KEY=
# Opcional: modelo de texto autorizado; sem override é consultado models.list.
INOVA_DOCS_MODEL=
# Central: modelo autorizado e homologado; sem configuração, checklist manual.
INOVA_CENTRAL_MODEL=

# Etapa 2: exclusivamente no servidor document-center-official. Sem valores padrão.
# As referências abaixo não ativam contrato nem comprovam homologação.
SERPRO_CND_COMPANY_ID=
SERPRO_CND_CONSUMER_KEY=
SERPRO_CND_CONSUMER_SECRET=
SERPRO_CND_ENDPOINT=
SERPRO_CND_AUTHORIZATION_REFERENCE=
SERPRO_CND_ALLOW_BILLABLE_ISSUANCE=false
# GEMINI_MODEL= pode ser reaproveitado da integração já existente.
# SUPABASE_URL e SUPABASE_ANON_KEY são fornecidos pelo runtime Supabase.
